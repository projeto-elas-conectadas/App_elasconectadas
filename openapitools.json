{
  "$schema": "./node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.22.0",
    "generators": {
      "flutter-api": {
        "generatorName": "dart-dio",
        "inputSpec": "./Elas_Conectadas_BackEnd/openapi-spec.json",
        "output": "./Elas_Conectadas_FrontEnd/packages/openapi",
        "additionalProperties": {
          "pubName": "openapi",
          "serializationLibrary": "built_value"
        }
      }
    }
  }
}

  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token JWT obtido no login. Envie no header Authorization como Bearer <token>."
      }
    },
    "schemas": {
      "ErroPadrao": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer",
            "example": 400,
            "description": "Código do status HTTP"
          },
          "message": {
            "description": "Mensagem detalhada sobre o que deu errado",
            "oneOf": [
              {
                "type": "string",
                "example": "Requisição inválida. Verifique os dados enviados."
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "error": {
            "type": "string",
            "example": "Bad Request",
            "description": "Nome oficial do erro HTTP"
          },
          "path": {
            "type": "string",
            "example": "/upload/imagem",
            "description": "Rota em que o erro ocorreu"
          },
          "errors": {
            "type": "array",
            "description": "Detalhes do validador OpenAPI, quando existirem",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "ErroNaoEncontrado": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer",
            "example": 404
          },
          "message": {
            "type": "string",
            "example": "O recurso solicitado não foi encontrado no sistema."
          },
          "error": {
            "type": "string",
            "example": "Not Found"
          },
          "path": {
            "type": "string"
          }
        }
      },
      "LoginDto": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "empreendedora@teste.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "SenhaSegura123!"
          }
        }
      },
      "LoginResponseDto": {
        "type": "object",
        "required": [
          "access_token",
          "user"
        ],
        "properties": {
          "access_token": {
            "type": "string",
            "description": "Token JWT para autenticação"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponseDto"
          }
        }
      },
      "sendEmailDto": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "empreendedora@teste.com",
            "description": "E-mail da destinatária"
          }
        }
      },
      "requestTokenDto": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "empreendedora@teste.com"
          }
        }
      },
      "VerifyOtpDto": {
        "type": "object",
        "required": [
          "email",
          "otp"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "otp": {
            "type": "string",
            "example": "123456",
            "description": "Código OTP recebido por e-mail"
          }
        }
      },
      "UserResponseDto": {
        "type": "object",
        "required": [
          "id",
          "email",
          "name",
          "role",
          "accountStatus"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "dob": {
            "type": "string",
            "nullable": true,
            "description": "Data de nascimento no formato DD/MM/AAAA"
          },
          "occupation": {
            "type": "string",
            "nullable": true
          },
          "rua": {
            "type": "string",
            "nullable": true
          },
          "numero": {
            "type": "string",
            "nullable": true
          },
          "bairro": {
            "type": "string",
            "nullable": true
          },
          "cidade": {
            "type": "string",
            "nullable": true
          },
          "estado": {
            "type": "string",
            "nullable": true
          },
          "bio": {
            "type": "string",
            "nullable": true
          },
          "pfp": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "role": {
            "type": "string",
            "enum": [
              "USER",
              "ADMIN"
            ]
          },
          "accountStatus": {
            "type": "string",
            "enum": [
              "VERIFIED",
              "UNVERIFIED"
            ]
          }
        }
      },
      "CreateUserDto": {
        "type": "object",
        "required": [
          "email",
          "password",
          "name",
          "phone",
          "dob"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "empreendedora@teste.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "SenhaSegura123!"
          },
          "name": {

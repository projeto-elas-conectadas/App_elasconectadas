{
  "openapi": "3.0.0",
  "info": {
    "title": "API Elas Conectadas",
    "description": "Arquitetura Orientada a Contratos (Modular)",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "https://api.elasconectadas.com",
      "description": "Servidor de Produção"

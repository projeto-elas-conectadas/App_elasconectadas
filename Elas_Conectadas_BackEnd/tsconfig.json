{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "paths": {
      "src/*": ["./src/*"]
    },
    "incremental": true,
    "skipLibCheck": true,
    
    // MELHORIAS PARA SPEC-DRIVEN:
    "strict": true,               // Ativa todas as opções de verificação rigorosa
    "strictNullChecks": true,     // Essencial para garantir que os campos do YAML mapeiam para valores reais
    "noImplicitAny": true,        // Evita que variáveis não tipadas passem despercebidas
    "esModuleInterop": true,      // Necessário para importar bibliotecas como o swagger-parser
    
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true
  }
}